# Copy to .env. Never commit .env.
# OpenFreeMap supplies the keyless basemap; only the planner URL is optional.
# Build with: flutter run --dart-define-from-file=.env
# Empty keeps SeedItineraryRepository. With tools/plan_server/start.bat running (it sets
# `adb reverse` for every connected emulator and USB phone): http://127.0.0.1:8787
PLAN_API_URL=
